pipeline {

    agent any

    environment {
        IMAGE_NAME      = "cloudcart-backend"
        IMAGE_TAG       = "${BUILD_NUMBER}"
        DEPLOYMENT_NAME = "cloudcart-backend"
        CONTAINER_NAME  = "backend"
    }

    stages {

        stage('Checkout Source Code') {
            steps {
                git branch: 'feature/devsecops',
                    credentialsId: 'github-ssh',
                    url: 'git@github.com:Viki08viki/Cloud-Cart.git'
            }
        }

        stage('Verify Environment') {
            steps {
                sh '''
                echo "Docker:"
                docker --version

                echo "Kubernetes:"
                kubectl get nodes

                echo "Trivy:"
                trivy --version
                '''
            }
        }

        stage('Secret Security Gate') {
            steps {
                sh '''
                trivy fs \
                  --scanners secret \
                  --exit-code 1 \
                  --skip-dirs .git \
                  --skip-dirs terraform/.terraform \
                  .
                '''
            }
        }

        stage('Dependency Security Gate') {
            steps {
                sh '''
                trivy fs \
                  --scanners vuln \
                  --severity HIGH,CRITICAL \
                  --ignore-unfixed \
                  --exit-code 1 \
                  --skip-dirs .git \
                  --skip-dirs terraform/.terraform \
                  .
                '''
            }
        }

        stage('Terraform Security Audit') {
            steps {
                sh '''
                echo "Terraform findings are reported for review."
                echo "Accepted CloudCart lab findings will not block deployment."

                trivy config \
                  --severity HIGH,CRITICAL \
                  --exit-code 0 \
                  terraform/
                '''
            }
        }

        stage('Kubernetes Security Gate') {
            steps {
                sh '''
                trivy config \
                  --severity HIGH,CRITICAL \
                  --exit-code 1 \
                  kubernetes/backend-deployment.yaml
                '''
            }
        }

        stage('Build Docker Image') {
            steps {
                sh '''
                docker build \
                  --pull \
                  -t ${IMAGE_NAME}:${IMAGE_TAG} \
                  app/backend
                '''
            }
        }

        stage('Container Security Gate') {
            steps {
                sh '''
                trivy image \
                  --scanners vuln \
                  --severity HIGH,CRITICAL \
                  --ignore-unfixed \
                  --exit-code 1 \
                  ${IMAGE_NAME}:${IMAGE_TAG}
                '''
            }
        }

        stage('Run Tests') {
            steps {
                sh '''
                docker run --rm ${IMAGE_NAME}:${IMAGE_TAG} \
                  python -m py_compile app.py

                docker run --rm ${IMAGE_NAME}:${IMAGE_TAG} id
                '''
            }
        }

        stage('Load Image into Minikube') {
            steps {
                sh '''
                docker save ${IMAGE_NAME}:${IMAGE_TAG} | \
                  docker exec -i minikube docker load
                '''
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                sh '''
                sed "s#image: cloudcart-backend:.*#image: ${IMAGE_NAME}:${IMAGE_TAG}#" \
                  kubernetes/backend-deployment.yaml | \
                  kubectl apply -f -

                kubectl rollout status \
                  deployment/${DEPLOYMENT_NAME} \
                  --timeout=120s
                '''
            }
        }

        stage('Verify Deployment') {
            steps {
                sh '''
                CURRENT_IMAGE=$(kubectl get deployment ${DEPLOYMENT_NAME} \
                  -o jsonpath='{.spec.template.spec.containers[0].image}')

                echo "Expected image: ${IMAGE_NAME}:${IMAGE_TAG}"
                echo "Deployed image: ${CURRENT_IMAGE}"

                test "${CURRENT_IMAGE}" = "${IMAGE_NAME}:${IMAGE_TAG}"

                echo "Runtime identity:"
                kubectl exec deployment/${DEPLOYMENT_NAME} -- id

                kubectl get pods
                '''
            }
        }

        stage('Health Check') {
            steps {
                sh '''
                kubectl exec deployment/${DEPLOYMENT_NAME} -- \
                  python -c "import urllib.request; print(urllib.request.urlopen('http://cloudcart-backend-service:5000/health', timeout=10).read().decode())"
                '''
            }
        }

        stage('Application Test') {
            steps {
                sh '''
                kubectl exec deployment/${DEPLOYMENT_NAME} -- \
                  python -c "import urllib.request; print(urllib.request.urlopen('http://cloudcart-backend-service:5000/products', timeout=10).read().decode())"
                '''
            }
        }
    }

    post {

        success {
            echo "CloudCart DevSecOps pipeline completed successfully."
        }

        failure {
            echo "CloudCart pipeline failed. Deployment may have been blocked by a security or validation gate."

            sh '''
            kubectl get pods || true
            kubectl get deployment cloudcart-backend || true
            '''
        }

        always {
            echo "CloudCart pipeline execution completed."
        }
    }
}
